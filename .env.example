# Base de données Postgres (Neon en préversion et production, Postgres local en développement)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pise

# Secret Payload : chaîne aléatoire longue, différente par environnement
PAYLOAD_SECRET=

# Adresse publique du site, sans barre finale. À laisser vide sur les préversions ;
# à renseigner en production une fois le domaine définitif branché.
NEXT_PUBLIC_SERVER_URL=

# Vercel Blob : laisser vide en local, les médias restent alors sur le disque
BLOB_READ_WRITE_TOKEN=
